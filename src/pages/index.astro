  text-transform:uppercase;letter-spacing:.08em;color:var(--tenue);
  border:1px solid var(--linea);border-radius:20px;padding:1px 8px;margin-top:2px}

/* La fascia deve vincere sulle regole generiche di .strumento, che si
   caricano dopo quelle del sito. */
