/* .strumento *{padding:0} azzera l'imbottitura di qualsiasi discendente:
   il pulsante va ridichiarato con specificità maggiore. */
.strumento .bottone-eroe{display:inline-block;background:var(--blu);color:#fff;
  font-weight:700;font-size:1.05rem;padding:17px 38px;border-radius:10px;
  text-decoration:none;line-height:1;margin-top:6px}
.strumento .bottone-eroe:hover{background:var(--blu-scuro);color:#fff}

/* --- mappa dei nove gruppi ---------------------------------------------- */
.strumento .mappa{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  gap:10px;margin:26px 0 40px}
.strumento .mappa a{display:block;background:var(--grigio);border-radius:12px;
  padding:14px 16px;text-decoration:none}
.strumento .mappa a:hover{background:#eaeff7}
.strumento .mappa b{display:block;font-size:1.5rem;font-weight:800;color:var(--inchiostro);
  line-height:1}
.strumento .mappa span{display:block;font-size:.84rem;color:var(--grafite);margin-top:4px;
  line-height:1.35}

/* --- un gruppo, una banda colorata -------------------------------------- */
.strumento .gruppo{border-left:4px solid;padding:2px 0 2px 24px;margin:0 0 44px}
.strumento .gruppo h3{font-size:1.5rem;font-weight:800;color:var(--inchiostro);
  margin:0 0 14px;letter-spacing:-.02em}
.strumento .gruppo p{max-width:74ch;color:var(--grafite);margin-bottom:16px}
.strumento .punti-gruppo-testo{display:inline-block;font-size:.72rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.08em;vertical-align:middle;margin-left:10px;
  padding:4px 10px;border-radius:20px}
.strumento .gruppo.blu{border-left-color:#1f6feb}
.strumento .gruppo.blu .punti-gruppo-testo{background:#e8f1ff;color:#14417f}
.strumento .gruppo.viola{border-left-color:#6b5bd2}
.strumento .gruppo.viola .punti-gruppo-testo{background:#eeecfd;color:#3c3489}
.strumento .gruppo.verde{border-left-color:#0f9d6e}
.strumento .gruppo.verde .punti-gruppo-testo{background:#e3f5ee;color:#0a5c44}
.strumento .gruppo.arancio{border-left-color:#e07b00}
.strumento .gruppo.arancio .punti-gruppo-testo{background:#fdf0dd;color:#7a4a06}
.strumento .gruppo.rosso{border-left-color:#d94054}
.strumento .gruppo.rosso .punti-gruppo-testo{background:#fdeaec;color:#8f1f2e}

/* --- il riquadro "cosa trovo più spesso" -------------------------------- */
.strumento .trovato{background:var(--grigio);border-radius:12px;padding:20px 24px;
  margin:0 0 18px}
.strumento .trovato b{display:block;font-size:.74rem;text-transform:uppercase;
  letter-spacing:.1em;color:var(--tenue);margin-bottom:10px}
.strumento .trovato p{font-size:1rem;margin-bottom:12px;color:var(--grafite)}
.strumento .trovato p:last-child{margin-bottom:0}
.strumento .gruppo code,.strumento .trovato code{background:#eef2f8;color:#14417f;
  padding:1px 6px;border-radius:4px;font-size:.88em}
.strumento .lettura-ampia a{color:var(--blu);text-decoration:underline;
  text-underline-offset:2px}

/* --- mappa a quadranti --------------------------------------------------- */
.strumento .mappa{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
  gap:12px;margin:28px 0 46px}
.strumento .mappa a{display:block;text-align:center;background:var(--grigio);
  border-radius:14px;padding:18px 12px;text-decoration:none;transition:background .14s}
.strumento .mappa a:hover{background:#e9eff8}
.strumento .mappa .cerchio{position:relative;display:inline-block;margin-bottom:8px}
.strumento .mappa .cerchio .cifra{font-size:21px;font-weight:800}
.strumento .mappa .etichetta-gruppo{display:block;font-size:.85rem;font-weight:600;
  color:var(--inchiostro);line-height:1.35}
.strumento .mappa .t-blu .arco{stroke:#1f6feb}
.strumento .mappa .t-blu .cifra{fill:#1f6feb}
.strumento .mappa .t-viola .arco{stroke:#6b5bd2}
.strumento .mappa .t-viola .cifra{fill:#6b5bd2}
.strumento .mappa .t-verde .arco{stroke:#0f9d6e}
.strumento .mappa .t-verde .cifra{fill:#0f9d6e}
.strumento .mappa .t-arancio .arco{stroke:#e07b00}
.strumento .mappa .t-arancio .cifra{fill:#e07b00}
.strumento .mappa .t-rosso .arco{stroke:#d94054}
.strumento .mappa .t-rosso .cifra{fill:#d94054}

/* --- tabelle dei dati ---------------------------------------------------- */
.strumento .tabella-dati{width:100%;border-collapse:collapse;margin:6px 0 22px;
  font-size:.95rem;background:#fff;border:1px solid var(--linea);border-radius:12px;
  overflow:hidden}
.strumento .tabella-dati th{background:var(--grigio);text-align:left;padding:12px 16px;
  font-size:.78rem;text-transform:uppercase;letter-spacing:.07em;color:var(--tenue);
  font-weight:700}
.strumento .tabella-dati td{padding:11px 16px;border-top:1px solid var(--linea);
  color:var(--grafite);vertical-align:top}
.strumento .tabella-dati td:first-child{color:var(--inchiostro);font-weight:600}
.strumento .tabella-dati td.si{color:#0a7d59;font-weight:700}
.strumento .tabella-dati td.no{color:#c02840;font-weight:700}

/* --- due blocchi di codice a confronto ----------------------------------- */
.strumento .due-codici{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:14px;margin:6px 0 22px}
.strumento .codice{border-radius:12px;padding:16px 18px;border:1px solid var(--linea)}
.strumento .codice b{display:block;font-size:.74rem;text-transform:uppercase;
  letter-spacing:.09em;margin-bottom:10px}
.strumento .codice pre{margin:0;overflow-x:auto}
.strumento .codice code{background:none;padding:0;font-size:.84rem;line-height:1.6;
  color:var(--inchiostro);white-space:pre}
.strumento .codice span{display:block;font-size:.84rem;margin-top:10px;color:#c02840}
.strumento .codice.ok{background:#f2faf6;border-color:#c8e8db}
.strumento .codice.ok b{color:#0a7d59}
.strumento .codice.ko{background:#fdf5f6;border-color:#f2ced5}
.strumento .codice.ko b{color:#c02840}

/* --- gerarchia dei titoli ------------------------------------------------ */
.strumento .gerarchia{background:#fff;border:1px solid var(--linea);border-radius:12px;
  padding:14px 16px;margin:6px 0 22px;font-size:.95rem}
.strumento .gerarchia .riga{padding:7px 0;color:var(--grafite)}
.strumento .gerarchia .liv2{padding-left:26px}
.strumento .gerarchia .liv3{padding-left:52px}
.strumento .gerarchia .tag{display:inline-block;font-family:var(--mono);font-size:.74rem;
  font-weight:700;padding:2px 8px;border-radius:5px;margin-right:10px}
.strumento .gerarchia .ok .tag{background:#e3f5ee;color:#0a5c44}
.strumento .gerarchia .ko .tag{background:#fdeaec;color:#8f1f2e}
.strumento .gerarchia .ko{color:#8f1f2e}
.strumento .gerarchia em{font-style:normal;font-size:.8rem;color:#c02840;margin-left:10px}

/* --- anteprima del risultato di ricerca ---------------------------------- */
.strumento .serp{background:#fff;border:1px solid var(--linea);border-radius:12px;
  padding:18px 20px;margin:6px 0 22px;max-width:620px}
.strumento .serp-url{font-size:.82rem;color:#3c7a3c;margin-bottom:4px}
.strumento .serp-titolo{font-size:1.22rem;color:#1a0dab;line-height:1.3;margin-bottom:4px}
.strumento .serp-testo{font-size:.9rem;color:#4d5156;line-height:1.55}
.strumento .serp-misura{display:flex;gap:16px;margin-top:12px;padding-top:10px;
  border-top:1px dashed var(--linea)}
.strumento .serp-misura span{font-family:var(--mono);font-size:.74rem;color:var(--tenue)}

/* --- soglie dei Core Web Vitals ------------------------------------------ */
.strumento .soglie{display:grid;gap:16px;margin:6px 0 22px}
.strumento .soglie>div{background:#fff;border:1px solid var(--linea);border-radius:12px;
  padding:14px 18px}
.strumento .soglie b{font-family:var(--mono);font-size:.92rem;color:var(--inchiostro);
  margin-right:10px}
.strumento .soglie>div>span{font-size:.88rem;color:var(--grafite)}
.strumento .soglie i{display:flex;height:9px;border-radius:5px;overflow:hidden;margin:10px 0 6px}
.strumento .soglie em{display:block;height:100%}
.strumento .soglie em.v{background:#0f9d6e}
.strumento .soglie em.g{background:#e0a800}
.strumento .soglie em.r{background:#d94054;flex:1}
.strumento .soglie u{display:flex;text-decoration:none}
.strumento .soglie u span{font-size:.74rem;color:var(--tenue)}
.strumento .soglie u span:nth-child(1){width:44%}
.strumento .soglie u span:nth-child(2){width:22%}
.strumento .soglie u span:nth-child(3){flex:1;text-align:right}

/* i collegamenti sottolineati valgono nel testo, non nelle schede */
.strumento .mappa a,.strumento .mappa a *{text-decoration:none}

.strumento .continua{margin:14px 0 0}
.strumento .continua a{display:inline-block;font-weight:700;font-size:.95rem;
  color:var(--blu);text-decoration:none}
.strumento .continua a::after{content:" \2192"}
.strumento .continua a:hover{text-decoration:underline}
.strumento .gruppo b{color:var(--inchiostro);font-weight:700}

.strumento .quadrante .cifra-grande{font-size:34px;font-weight:800;letter-spacing:-.02em}

/* --- elenchi lunghi in tendina ------------------------------------------ */
.strumento .elenco-pagine{margin-top:.5rem}
.strumento .elenco-pagine summary{cursor:pointer;font-size:.82rem;font-weight:600;
  color:var(--blu);list-style:none;display:inline-flex;align-items:center;gap:6px}
.strumento .elenco-pagine summary::-webkit-details-marker{display:none}
.strumento .elenco-pagine summary::before{content:"\25B8";font-size:.75rem;
  transition:transform .12s}
.strumento .elenco-pagine[open] summary::before{transform:rotate(90deg)}
.strumento .elenco-pagine .dove{margin-top:.5rem;max-height:320px;overflow-y:auto;
