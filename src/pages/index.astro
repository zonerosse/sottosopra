  color:var(--inchiostro)}
.strumento .rilievo p{margin:0;max-width:74ch;color:var(--grafite)}
.strumento .rilievo.rosso{border-left-color:#d94054}
.strumento .rilievo.giallo{border-left-color:#c2870a}
.strumento .rilievo.blu{border-left-color:#1f6feb}
.strumento .principi{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:26px;margin:24px 0 8px}
.strumento .principio{border-left:4px solid #0f9d6e;padding:2px 0 2px 22px}
.strumento .principio b{display:block;font-size:1.1rem;color:var(--inchiostro);
  margin-bottom:8px;font-weight:700}
.strumento .principio p{margin:0;max-width:none;font-size:1rem;color:var(--grafite)}
/* --- la parte discorsiva: caratteri più grandi e riquadri colorati ------ */
