.strumento .nome-gruppo{display:block;font-size:.84rem;font-weight:600;color:var(--inchiostro);
  line-height:1.35}
.strumento .punti-gruppo{display:block;font-size:.74rem;color:var(--grafite);margin-top:2px}

.strumento .schede{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));
  gap:14px;margin:0 0 34px}
.strumento .scheda-strumento{display:flex;gap:14px;align-items:flex-start;
  background:var(--foglio);border:1px solid var(--linea);border-radius:14px;padding:18px;
  text-decoration:none;color:inherit;transition:border-color .14s,transform .14s}
