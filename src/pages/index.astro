.strumento .dove-manca.chiusa>summary{cursor:pointer;list-style:none;display:flex;
    align-items:baseline;gap:.5rem;margin-bottom:.3rem}
.strumento .dove-manca.chiusa>summary::-webkit-details-marker{display:none}
.strumento .dove-manca.chiusa>summary .apri{font-size:.76rem;color:var(--verde);text-decoration:underline;
    text-underline-offset:2px;margin-left:auto}
.strumento .dove-manca.chiusa[open]>summary .apri::after{content:" (chiudi)"}
.strumento .riga-dove{display:flex;gap:.6rem;align-items:baseline;padding:.14rem 0;
    border-bottom:1px solid var(--linea)}
.strumento .riga-dove:last-child{border-bottom:0}
.strumento .riga-dove a{font-family:var(--mono);font-size:.76rem;color:var(--verde);
    text-decoration:none;word-break:break-all;flex:1}
.strumento .riga-dove a:hover{text-decoration:underline}
.strumento .riga-dove code{font-family:var(--mono);font-size:.76rem;color:var(--rosso);
    word-break:break-all;flex:1}
.strumento .riga-dove em{font-style:normal;font-size:.76rem;color:var(--grafite);white-space:nowrap}
.strumento .difetto{background:var(--fondo);border-radius:6px;padding:.5rem .7rem;margin:.2rem 0 .5rem}
.strumento .difetto b{display:block;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;
    color:var(--grafite);margin-bottom:.15rem}
.strumento .altre-schede>summary{cursor:pointer;padding:.6rem .8rem;background:var(--carta);
    border:1px solid var(--linea);border-radius:8px;font-size:.86rem;color:var(--verde);
    margin-bottom:.4rem}
.strumento /* --- velocità: cerchi e pallini --- */
  .cerchi-velocita{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
    gap:.6rem;margin:0 0 1rem;background:var(--carta);border:1px solid var(--linea);
    border-radius:10px;padding:1rem .8rem}
.strumento .cerchi-velocita>div{text-align:center}
.strumento .cerchi-velocita svg{margin:0 auto .35rem}
.strumento .cerchi-velocita span{display:block;font-size:.78rem;color:var(--grafite);line-height:1.3}
.strumento td.metrica{display:flex;gap:.55rem;align-items:flex-start}
.strumento td.metrica .segno{font-size:.7rem;line-height:1.7;flex-shrink:0}
.strumento td.metrica b{font-weight:600}
.strumento .riquadro-gruppo{display:block;text-decoration:none;color:inherit;
    background:var(--fondo);border:1px solid transparent;border-radius:7px;
    padding:.5rem .6rem;transition:border-color .12s,background .12s}
.strumento .riquadro-gruppo:hover, .strumento .riquadro-gruppo:focus-visible{border-color:var(--verde);
    background:var(--carta);outline:none}
.strumento .titolo-gruppo{scroll-margin-top:1rem}
.strumento /* --- cerchio nel titolo di gruppo --- */
  .titolo-gruppo{display:flex;align-items:center;gap:.7rem;margin:1.8rem 0 .6rem;
    font-size:1rem;font-weight:600}
.strumento .titolo-gruppo .nome{flex:1}
.strumento .titolo-gruppo .punti{font-family:var(--mono);font-size:.75rem;color:var(--grafite);
    font-weight:400;white-space:nowrap}
.strumento .cerchio-gruppo{flex-shrink:0;display:block}
@media (max-width:520px){.strumento .titolo-gruppo{font-size:.92rem;gap:.5rem}
.strumento .titolo-gruppo .punti{display:none}}
@media print{.strumento{background:#fff}
.strumento .modulo, .strumento .avanzamento, .strumento .azioni, .strumento button, .strumento .briciole{display:none !important}
.strumento .foglio{max-width:none;padding:0}
.strumento .controllo[open] .spiega{display:block}
.strumento .chiusura{background:#fff;color:#000;border:1px solid #000}
.strumento .chiusura h2, .strumento .chiusura p, .strumento .chiusura li{color:#000}}
@media (prefers-reduced-motion:reduce){.strumento *{transition:none !important}}

.strumento .gruppi{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;
  background:none;border:0}
.strumento .riquadro-gruppo{display:block;text-align:center;background:var(--blu-chiaro);
