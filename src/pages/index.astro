.strumento .eroe h1{color:#fff;font-size:clamp(2rem,4.6vw,3rem);font-weight:800;
  letter-spacing:-.035em;line-height:1.14;margin:0 auto 14px;max-width:22ch}
.strumento .eroe h1 em{font-style:normal;color:#4da3ff}
.strumento .eroe .tesi{color:#c2d2e8;font-size:1.06rem;max-width:56ch;margin:0 auto 30px}
.strumento .eroe .nota{color:#8fa3c4;font-size:.86rem;margin-top:16px}
.strumento .eroe .modulo{background:none;border:0;padding:0;max-width:640px;margin:0 auto}
.strumento .eroe .campo{display:flex;gap:0;background:#fff;border-radius:10px;padding:6px;
