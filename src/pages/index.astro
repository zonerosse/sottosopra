.strumento .mattonella{flex:0 0 46px;height:46px;border-radius:13px;display:grid;
  place-items:center;color:#fff}
.strumento .mattonella svg{width:22px;height:22px;stroke:currentColor;fill:none;
  stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.strumento .mattonella.uno{background:#12386b}
.strumento .mattonella.due{background:#0e86b8}
.strumento .mattonella.tre{background:#f5a623;color:#3d2600}
.strumento .mattonella.quattro{background:#12a3a3}
.strumento .scheda-strumento .testo{flex:1;min-width:0}
.strumento .scheda-strumento b{display:block;font-size:1.05rem;color:#1565c0;
  margin-bottom:5px;font-weight:700;letter-spacing:-.01em}
.strumento .scheda-strumento .testo>span{display:block;font-size:.9rem;color:var(--grafite);
