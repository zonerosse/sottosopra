.strumento .quadrantino{position:relative;display:inline-block;margin-bottom:8px}
.strumento .quadrantino .cifra{font-size:19px;font-weight:800;fill:currentColor}
.strumento .quadrantino .cifra.liv-ok{fill:var(--verde)}
.strumento .quadrantino .cifra.liv-giallo{fill:var(--giallo)}
.strumento .quadrantino .cifra.liv-arancio{fill:var(--arancio)}
.strumento .quadrantino .cifra.liv-rosso{fill:var(--rosso)}
.strumento .quadrantino .cifra.liv-grigio{fill:var(--grafite)}
.strumento .arco{stroke:var(--verde)}
.strumento .arco.liv-giallo{stroke:var(--giallo)}
.strumento .arco.liv-arancio{stroke:var(--arancio)}
.strumento .arco.liv-rosso{stroke:var(--rosso)}
