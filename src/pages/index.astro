.strumento .eroe button{height:52px;padding:0 30px;font-size:1rem;font-weight:700;
  border-radius:8px;background:var(--blu);color:#fff}
.strumento .eroe button:hover{background:var(--blu-scuro)}
.strumento{background:#fff}
.strumento .foglio{max-width:none;padding:0}

/* --- la parte discorsiva: caratteri più grandi e riquadri colorati ------ */
